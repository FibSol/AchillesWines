DATABASE_URL=data/achilles.db
NEXT_PUBLIC_APP_NAME=Achilles's Wines
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# docker-compose: host port nginx publishes (default 8080).
# Set to 80 for direct LAN access, or keep 8080 and front with HA add-on ingress.
ACHILLES_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# APScheduler — per-source cron schedules (ADR-012 — see scraper/job_runner.py)
# Pattern: ACHILLES_SCHEDULE_<SOURCE_CODE_UPPER>=<cron expression>
# The source code must match a source_code value in dim_source exactly
# (case-insensitive — the env var suffix is lowercased before lookup).
# If an env var is absent for a source, that source remains manual-only.
# Uses standard 5-field cron syntax: minute hour day month day_of_week
# -----------------------------------------------------------------------------
# --- Run millesima scraper daily at 03:00 ---
# ACHILLES_SCHEDULE_MILLESIMA=0 3 * * *
# --- Run millesima_email scraper Monday at 02:30 ---
# ACHILLES_SCHEDULE_MILLESIMA_EMAIL=30 2 * * 1
# --- Run idealwine_email scraper daily at 04:00 ---
# ACHILLES_SCHEDULE_IDEALWINE_EMAIL=0 4 * * *
# --- Run lavinia_email scraper daily at 04:30 ---
# ACHILLES_SCHEDULE_LAVINIA_EMAIL=30 4 * * *

# Optional — Claude API key.
# Used for TWO features:
#   1. LLM email fallback parser: retries newsletter emails that yield 0 offers
#      via the heuristic parser, using Claude claude-haiku-4-5. Opt-in per source via
#      `use_llm_fallback=1` in dim_source. Cost: ~$0.0025/email.
#      Only activates when the key is set AND the source has use_llm_fallback=1.
#   2. Claude Vision OCR on wine labels (Phase 4, not yet implemented).
# ANTHROPIC_API_KEY=

# Optional — for promo notifications
# WEBHOOK_HA_URL=

# Optional — for FX rates (only if you scrape non-EUR sources)
# FRANKFURTER_API_BASE=https://api.frankfurter.app

# -----------------------------------------------------------------------------
# Mailbox connection for email-newsletter scrapers (ADR-011 — see docs/EMAIL.md)
# Pick ONE of the patterns below.
# -----------------------------------------------------------------------------

# --- Pattern A: Gmail (App Password) -----------------------------------------
# Implicit TLS on port 993. Generate the password at
# https://myaccount.google.com/apppasswords (16 chars; your regular Gmail
# password will NOT work for IMAP).
# ACHILLES_MAILBOX_HOST=imap.gmail.com
# ACHILLES_MAILBOX_PORT=993
# ACHILLES_MAILBOX_USERNAME=wine-newsletters@yourdomain.com
# ACHILLES_MAILBOX_PASSWORD=
# ACHILLES_MAILBOX_SSL=1
# ACHILLES_MAILBOX_FOLDER=INBOX

# --- Pattern B: Proton Mail via Proton Mail Bridge ---------------------------
# Requires a paid Proton plan (Plus / Unlimited / Family / Business). Bridge
# runs on the host, listens on 127.0.0.1:1143, generates its own per-app
# password (NOT your Proton account password). Self-signed cert auto-accepted
# because the host is loopback.
# ACHILLES_MAILBOX_HOST=127.0.0.1
# ACHILLES_MAILBOX_PORT=1143
# ACHILLES_MAILBOX_USERNAME=your-newsletter-account@proton.me
# ACHILLES_MAILBOX_PASSWORD=<bridge-generated app password>
# ACHILLES_MAILBOX_SSL=0
# ACHILLES_MAILBOX_STARTTLS=1
# ACHILLES_MAILBOX_FOLDER=INBOX

# -----------------------------------------------------------------------------
# Per-source scraper authentication (ADR-010 — see docs/AUTH.md)
# Pattern: ACHILLES_AUTH_<SOURCE_CODE_UPPER>_USERNAME / _PASSWORD
# Credentials are read by the Python sidecar only; never written to DB.
# Mark a source as `requires_auth = 1` in dim_source for it to appear on
# /admin/auth.
# -----------------------------------------------------------------------------
# --- Wine shops ---
# ACHILLES_AUTH_IDEALWINE_USERNAME=
# ACHILLES_AUTH_IDEALWINE_PASSWORD=
# ACHILLES_AUTH_LAVINIA_USERNAME=
# ACHILLES_AUTH_LAVINIA_PASSWORD=
# ACHILLES_AUTH_VINATIS_USERNAME=
# ACHILLES_AUTH_VINATIS_PASSWORD=
# ACHILLES_AUTH_WINE_SEARCHER_USERNAME=
# ACHILLES_AUTH_WINE_SEARCHER_PASSWORD=
# ACHILLES_AUTH_CAVISSIMA_BE_USERNAME=
# ACHILLES_AUTH_CAVISSIMA_BE_PASSWORD=
# ACHILLES_AUTH_VENTEALAPROPRIETE_USERNAME=
# ACHILLES_AUTH_VENTEALAPROPRIETE_PASSWORD=
# ACHILLES_AUTH_HACHETTE_VINS_SHOP_USERNAME=
# ACHILLES_AUTH_HACHETTE_VINS_SHOP_PASSWORD=
# ACHILLES_AUTH_COMPTOIR_DES_MILLESIMES_USERNAME=
# ACHILLES_AUTH_COMPTOIR_DES_MILLESIMES_PASSWORD=
# ACHILLES_AUTH_TOPWIJNEN_BE_USERNAME=
# ACHILLES_AUTH_TOPWIJNEN_BE_PASSWORD=
# ACHILLES_AUTH_MILLESIMA_BE_USERNAME=
# ACHILLES_AUTH_MILLESIMA_BE_PASSWORD=
# ACHILLES_AUTH_VINSBRUNIN_USERNAME=
# ACHILLES_AUTH_VINSBRUNIN_PASSWORD=
# ACHILLES_AUTH_WIJNENDECLERCK_BE_USERNAME=
# ACHILLES_AUTH_WIJNENDECLERCK_BE_PASSWORD=
# ACHILLES_AUTH_BELGIUMWINEWATCHERS_USERNAME=
# ACHILLES_AUTH_BELGIUMWINEWATCHERS_PASSWORD=

# --- Crowd / community DB ---
# CellarTracker: world's largest user-driven wine DB. The scraper iterates
# wine.asp?iWine=N (1 .. ~6.5M) with a resumable cursor.
# ACHILLES_AUTH_CELLARTRACKER_USERNAME=
# ACHILLES_AUTH_CELLARTRACKER_PASSWORD=
# ACHILLES_CT_START_ID=1            # override resume cursor for a cold re-crawl
# ACHILLES_CT_DELAY_MIN=0.5         # politeness floor in seconds (sequential scraper only)
# ACHILLES_CT_DELAY_MAX=0.9
# --- cellartracker_fast (parallel iWine sweep) ---
# ACHILLES_CT_WORKERS=10            # concurrent Firecrawl requests (default 10, try 15-20 on paid plan)
# ACHILLES_CT_MIN_SCORE=90          # only save wines scoring >= this (0 = save all; 90 = best wines only)
# ACHILLES_CT_WAIT_MS=2500          # Firecrawl JS waitFor ms (default 2500; min ~1500 for Kasada)

# --- Price aggregators ---
# Firecrawl API key — required for:
#   • wine_searcher scraper (bypasses PerimeterX via Firecrawl /search)
#   • cellartracker parallel sweep (ACHILLES_CT_WORKERS concurrent requests)
#   • firecrawl CLI (same key — run `firecrawl login -k <key>` once)
# Recommended plan: Scale (100 000 credits/cycle, 50 concurrent jobs).
# Get one at https://firecrawl.dev — without this, wine_searcher logs
# scraper_not_applicable and exits cleanly; cellartracker falls back to
# sequential mode.
# FIRECRAWL_API_KEY=

# --- Wine press / subscriptions ---
# ACHILLES_AUTH_RVF_USERNAME=
# ACHILLES_AUTH_RVF_PASSWORD=
# ACHILLES_AUTH_MAGAZINES_FR_USERNAME=
# ACHILLES_AUTH_MAGAZINES_FR_PASSWORD=
# ACHILLES_AUTH_FIGARO_VIN_USERNAME=
# ACHILLES_AUTH_FIGARO_VIN_PASSWORD=
# ACHILLES_AUTH_TERREDEVINS_USERNAME=
# ACHILLES_AUTH_TERREDEVINS_PASSWORD=
# ACHILLES_AUTH_HACHETTE_VINS_USERNAME=
# ACHILLES_AUTH_HACHETTE_VINS_PASSWORD=
